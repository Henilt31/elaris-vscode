{
  "$schema": "vscode://schemas/color-theme",
  "name": "Elaris",
  "type": "light",
  "colors": {
    "focusBorder": "#5B4BDB66",
    "foreground": "#1D2433",
    "disabledForeground": "#9AA3B2",
    "widget.border": "#D9DEE7",
    "widget.shadow": "#1D24330F",
    "selection.background": "#5B4BDB25",
    "descriptionForeground": "#596273",
    "errorForeground": "#C93645",
    "icon.foreground": "#596273",

    "window.activeBorder": "#E7EAF0",
    "window.inactiveBorder": "#F7F8FA",

    "titleBar.activeBackground": "#F7F8FA",
    "titleBar.activeForeground": "#1D2433",
    "titleBar.inactiveBackground": "#F7F8FA",
    "titleBar.inactiveForeground": "#9AA3B2",
    "titleBar.border": "#E7EAF0",

    "activityBar.background": "#F7F8FA",
    "activityBar.foreground": "#1D2433",
    "activityBar.inactiveForeground": "#7A8495",
    "activityBar.border": "#E7EAF0",
    "activityBarBadge.background": "#5B4BDB",
    "activityBarBadge.foreground": "#FFFFFF",
    "activityBar.activeBorder": "#5B4BDB",
    "activityBar.activeFocusBorder": "#5B4BDB",

    "sideBar.background": "#F3F5F8",
    "sideBar.foreground": "#596273",
    "sideBar.border": "#E7EAF0",
    "sideBarTitle.foreground": "#1D2433",
    "sideBarSectionHeader.background": "#F3F5F8",
    "sideBarSectionHeader.foreground": "#1D2433",
    "sideBarSectionHeader.border": "#E7EAF0",

    "editorGroupHeader.tabsBackground": "#F3F5F8",
    "editorGroupHeader.tabsBorder": "#E7EAF0",
    "editorGroupHeader.noTabsBackground": "#F7F8FA",
    "editorGroup.border": "#E7EAF0",
    "editorGroup.dropBackground": "#5B4BDB15",

    "tab.activeBackground": "#FFFFFF",
    "tab.activeForeground": "#1D2433",
    "tab.activeBorder": "#FFFFFF",
    "tab.activeBorderTop": "#5B4BDB",
    "tab.inactiveBackground": "#F3F5F8",
    "tab.inactiveForeground": "#7A8495",
    "tab.border": "#E7EAF0",
    "tab.hoverBackground": "#EEF1F5",
    "tab.hoverForeground": "#1D2433",
    "tab.unfocusedActiveBackground": "#FFFFFF",
    "tab.unfocusedActiveForeground": "#596273",
    "tab.unfocusedActiveBorderTop": "#5B4BDB55",
    "tab.unfocusedInactiveBackground": "#F3F5F8",
    "tab.unfocusedInactiveForeground": "#9AA3B2",

    "editor.background": "#FFFFFF",
    "editor.foreground": "#1D2433",
    "editorLineNumber.foreground": "#9AA3B2",
    "editorLineNumber.activeForeground": "#5B4BDB",
    "editorCursor.foreground": "#5B4BDB",
    "editorCursor.background": "#FFFFFF",
    "editor.selectionBackground": "#5B4BDB22",
    "editor.selectionHighlightBackground": "#5B4BDB14",
    "editor.inactiveSelectionBackground": "#5B4BDB10",
    "editor.wordHighlightBackground": "#1687C818",
    "editor.wordHighlightStrongBackground": "#1687C828",
    "editor.findMatchBackground": "#B7790035",
    "editor.findMatchHighlightBackground": "#B7790018",
    "editor.findRangeHighlightBackground": "#EEF1F588",
    "editor.lineHighlightBackground": "#F7F8FA",
    "editor.lineHighlightBorder": "#00000000",
    "editorRuler.foreground": "#E7EAF0",
    "editorIndentGuide.background1": "#E7EAF0",
    "editorIndentGuide.activeBackground1": "#D9DEE7",
    "editorBracketMatch.background": "#5B4BDB18",
    "editorBracketMatch.border": "#5B4BDB55",
    "editorBracketHighlight.foreground1": "#5B4BDB",
    "editorBracketHighlight.foreground2": "#1687C8",
    "editorBracketHighlight.foreground3": "#218739",
    "editorBracketHighlight.foreground4": "#B77900",
    "editorBracketHighlight.foreground5": "#7C3AED",
    "editorBracketHighlight.foreground6": "#BE4056",
    "editorWhitespace.foreground": "#E7EAF0",
    "editorOverviewRuler.border": "#E7EAF0",
    "editorError.foreground": "#C93645",
    "editorWarning.foreground": "#B77900",
    "editorInfo.foreground": "#1687C8",
    "editorHint.foreground": "#218739",

    "editorGutter.background": "#FFFFFF",
    "editorGutter.modifiedBackground": "#1687C8",
    "editorGutter.addedBackground": "#218739",
    "editorGutter.deletedBackground": "#C93645",
    "editorGutter.commentRangeForeground": "#7A8495",
    "editorGutter.foldingControlForeground": "#7A8495",

    "statusBar.background": "#F7F8FA",
    "statusBar.foreground": "#596273",
    "statusBar.border": "#E7EAF0",
    "statusBar.debuggingBackground": "#F1F3F6",
    "statusBar.debuggingForeground": "#B77900",
    "statusBar.noFolderBackground": "#F7F8FA",
    "statusBar.noFolderForeground": "#596273",
    "statusBarItem.activeBackground": "#E8ECF2",
    "statusBarItem.hoverBackground": "#EEF1F5",
    "statusBarItem.prominentBackground": "#EEF1F5",
    "statusBarItem.remoteBackground": "#5B4BDB",
    "statusBarItem.remoteForeground": "#FFFFFF",

    "panel.background": "#F1F3F6",
    "panel.border": "#E7EAF0",
    "panelTitle.activeBorder": "#5B4BDB",
    "panelTitle.activeForeground": "#1D2433",
    "panelTitle.inactiveForeground": "#7A8495",

    "terminal.background": "#FFFFFF",
    "terminal.foreground": "#263043",
    "terminal.border": "#E7EAF0",
    "terminal.cursorForeground": "#5B4BDB",
    "terminal.selectionBackground": "#5B4BDB22"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "unused.comment"
      ],
      "settings": {
        "foreground": "#7A8495",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#16803C"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#B45309"
      }
    },
    {
      "name": "Constants & Booleans",
      "scope": [
        "constant",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": {
        "foreground": "#BE4056"
      }
    },
    {
      "name": "Keywords & Control",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7C3AED"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5B6474"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#2563EB"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#087EA4"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#1D2433"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#C2414B"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7C3AED"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#175EA8"
      }
    }
  ]
}
